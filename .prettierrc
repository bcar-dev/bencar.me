{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "endOfLine": "lf",
    "arrowParens": "always",
    "plugins": ["prettier-plugin-astro"],
    "overrides": [{ "files": "*.astro", "options": { "parser": "astro" } }]
}
