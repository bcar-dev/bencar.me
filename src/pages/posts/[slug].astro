---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/ui/Tag.vue';
import PostMeta from '@/components/ui/PostMeta.vue';
import PostNavigation from '@/components/ui/PostNavigation.astro';
import BackToTop from '@/components/ui/BackToTop.vue';
import ReadingProgress from '@/components/ui/ReadingProgress.vue';
import TableOfContents from '@/components/ui/TableOfContents.vue';
import { getPostWithNeighbors } from '@/lib/posts';
import { getHeroImage } from '@/lib/heroImages';
import { siteConfig } from '@/config/site';
import avatar from '@/assets/profile.jpg';

export async function getStaticPaths() {
    const entries = await getCollection('blog', ({ data }) => !data.draft);
    return entries.map((entry) => ({
        params: { slug: entry.id.split('/').pop() },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const slug = entry.id.split('/').pop()!;

const { post, prev, next } = getPostWithNeighbors(slug);
if (!post) return Astro.rewrite('/404');

const { Content } = await render(entry);
const hero = getHeroImage(post.frontmatter.heroImage);

// Build the TOC from posts.ts headings (extracted from raw markdown) rather than
// Astro's render() headings: those are collected after rehype-autolink-headings
// appends the "#" anchor, which would leak into each entry's text. Slugs still
// match the rendered heading ids (both use github-slugger).
const tocEntries = post.headings.map((h) => ({ text: h.text, slug: h.slug, level: h.level }));

const jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.frontmatter.title,
    description: post.frontmatter.description,
    image: new URL((hero ?? avatar).src, siteConfig.url).href,
    datePublished: new Date(post.frontmatter.pubDatetime).toISOString(),
    author: {
        '@type': 'Person',
        name: siteConfig.author.name,
        url: siteConfig.url,
    },
    // Escape `<` so a string containing `</script>` can't close the tag early.
}).replace(/</g, '\\u003c');
---

<BaseLayout
    title={post.frontmatter.title}
    description={post.frontmatter.description}
    ogType="article"
    image={hero?.src}
>
    <article class="py-8 w-full">
        <ReadingProgress client:idle />
        <script type="application/ld+json" set:html={jsonLd} is:inline />
        <header class="mb-8" id="top">
            <h1
                transition:name={`title-${post.slug}`}
                class="text-3xl font-bold tracking-tight sm:text-4xl text-accent w-fit"
            >
                {post.frontmatter.title}
            </h1>
            <div class="mt-3 flex items-center space-x-2 text-sm text-foreground/75 opacity-80">
                <PostMeta
                    pubDatetime={post.frontmatter.pubDatetime}
                    readingTime={post.readingTime}
                />
            </div>
            {
                post.frontmatter.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-2">
                        {post.frontmatter.tags.map((tag) => (
                            <Tag tag={tag} />
                        ))}
                    </div>
                )
            }

            {
                hero && (
                    <div class="mt-6 overflow-hidden rounded-lg border-2 border-accent/30">
                        <Image
                            src={hero}
                            alt={post.frontmatter.heroImageAlt ?? post.frontmatter.title}
                            widths={[480, 768, 1200]}
                            sizes="(max-width: 768px) 100vw, 768px"
                            class="w-full h-auto"
                            loading="eager"
                        />
                    </div>
                )
            }
        </header>

        <hr class="border-border opacity-50 mb-8" />

        <div class="prose prose-lg dark:prose-invert max-w-none markdown-content">
            <TableOfContents headings={tocEntries} client:visible />
            <Content />
        </div>

        <div class="mt-12 flex flex-col space-y-8">
            <div class="flex justify-center">
                <BackToTop client:visible />
            </div>

            <hr class="border-border opacity-50" />

            <PostNavigation prevPost={prev} nextPost={next} />
        </div>
    </article>
</BaseLayout>
