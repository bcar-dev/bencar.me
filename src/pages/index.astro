---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostListItem from '@/components/ui/PostListItem.astro';
import Icon from '@/components/Icon.astro';
import { getAllPosts } from '@/lib/posts';
import { siteConfig } from '@/config/site';

const recentPosts = getAllPosts().slice(0, siteConfig.pagination.recentPostsCount);
---

<BaseLayout>
    <div class="py-8 w-full">
        <h1 class="sr-only">{siteConfig.name} - Home</h1>
        <section aria-labelledby="recent-posts-heading" class="pt-8 pb-6">
            <h2 id="recent-posts-heading" class="text-2xl font-bold tracking-wide mb-6">
                Recent Posts
            </h2>
            {
                recentPosts.length === 0 ? (
                    <p class="text-foreground/75 italic">No posts yet. Stay tuned!</p>
                ) : (
                    <ul class="space-y-6">
                        {recentPosts.map((post) => (
                            <PostListItem
                                slug={post.slug}
                                title={post.frontmatter.title}
                                description={post.frontmatter.description}
                                pubDatetime={post.frontmatter.pubDatetime}
                                readingTime={post.readingTime}
                            />
                        ))}
                    </ul>
                )
            }

            {
                recentPosts.length > 0 && (
                    <div class="mt-10 flex justify-center">
                        <a
                            href="/posts"
                            class="hover:text-accent text-sm flex items-center transition-colors"
                        >
                            All Posts <Icon name="arrow-right" class="ml-1 w-4 h-4" />
                        </a>
                    </div>
                )
            }
        </section>
    </div>
</BaseLayout>
