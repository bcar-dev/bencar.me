---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedPosts from '@/components/ui/FeaturedPosts.vue';
import PostCard from '@/components/ui/PostCard.astro';
import { getAllPosts } from '@/lib/posts';
import { getHeroImage } from '@/lib/heroImages';
import { siteConfig } from '@/config/site';
import type { FeaturedSlide, OptimizedImage } from '@/types';

/** How many of the latest posts the slider at the top cycles through. */
const FEATURED_POST_COUNT = 4;

/**
 * The slider is a Vue island and can't use <Image>, so optimize its covers here
 * and hand it plain src/srcset strings.
 */
async function optimizeCover(hero: ImageMetadata): Promise<OptimizedImage> {
    const image = await getImage({ src: hero, widths: [800, 1200, 1600] });
    return {
        src: image.src,
        srcset: image.srcSet.attribute,
        width: hero.width,
        height: hero.height,
    };
}

const posts = getAllPosts();

const featuredSlides: FeaturedSlide[] = await Promise.all(
    posts.slice(0, FEATURED_POST_COUNT).map(async (post) => {
        const hero = getHeroImage(post.frontmatter.heroImage);
        return {
            slug: post.slug,
            title: post.frontmatter.title,
            description: post.frontmatter.description,
            pubDatetime: post.frontmatter.pubDatetime,
            readingTime: post.readingTime,
            image: hero ? await optimizeCover(hero) : undefined,
        };
    })
);
---

<BaseLayout wide>
    <h1 class="sr-only">{siteConfig.name} - Home</h1>
    {posts.length === 0 ? (
        <p class="py-16 text-foreground/75 italic">No posts yet. Stay tuned!</p>
    ) : (
        <div class="w-full py-12">
            <FeaturedPosts slides={featuredSlides} client:idle />

            <section aria-labelledby="all-articles-heading" class="mt-24">
                <h2
                    id="all-articles-heading"
                    class="flex items-baseline gap-2 border-b border-border pb-4 font-mono text-sm tracking-widest text-foreground/60 uppercase"
                >
                    <span class="text-foreground">{posts.length}</span>
                    {posts.length === 1 ? 'Article' : 'Articles'}
                </h2>
                <ul class="mt-10 grid grid-cols-1 gap-x-4 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
                    {posts.map((post) => (
                        <PostCard post={post} />
                    ))}
                </ul>
            </section>
        </div>
    )}
</BaseLayout>
