---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
    <div class="py-16 text-center">
        <h1 class="text-6xl font-bold text-accent mb-4">404</h1>
        <p class="text-xl text-foreground/80 mb-8">This page doesn't exist.</p>
        <a
            href="/"
            class="text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
        >
            Go back home
        </a>
    </div>
</BaseLayout>
