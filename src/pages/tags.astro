---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TagFilter from '@/components/ui/TagFilter.vue';
import { getAllPosts, getAllTags } from '@/lib/posts';

const posts = getAllPosts();
const tags = getAllTags();
---

<BaseLayout title="Tags" description="Filter blog posts by tags">
    <div class="py-8 w-full">
        <h1 class="my-8 text-3xl font-bold tracking-wider sm:text-4xl">Tags</h1>
        <TagFilter allTags={tags} allPosts={posts} client:load />
    </div>
</BaseLayout>
