---
interface Props {
    href: string;
    'aria-label': string;
    class?: string;
}

const { href, 'aria-label': ariaLabel, class: className } = Astro.props;

const BASE_CLASSES = 'inline-block transition-colors hover:text-accent';
---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={ariaLabel}
    class:list={[BASE_CLASSES, className]}
>
    <slot />
</a>
