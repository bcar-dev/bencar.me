{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "strictNullChecks": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "types": ["vitest/globals", "@testing-library/jest-dom"]
    },
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["node_modules", "dist", "coverage", "public/pagefind"]
}
